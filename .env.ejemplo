# Copia este archivo como ".env" (sin ".ejemplo") y completa una opción. El archivo .env no debe compartirse ni subirse a git.
# Sin este archivo (o sin clave), el agente funciona igual con el método básico de revisión de texto.

# ---------- Opción A: Claude, API de Anthropic ----------
# Crea la clave en https://console.anthropic.com/ (API keys) y pégala aquí. Empieza por "sk-ant-".
# Requiere créditos prepagados en la consola.
LLM_PROVEEDOR=anthropic
LLM_API_KEY=
# Modelo (por defecto claude-haiku-4-5, el más económico; claude-sonnet-5 o claude-opus-5 dan mayor calidad)
LLM_MODELO=claude-haiku-4-5

# ---------- Opción B: Gemini (Google), capa gratuita sin tarjeta ----------
# Crea la clave en https://aistudio.google.com/apikey ("Create API key").
# LLM_PROVEEDOR=openai_compatible
# LLM_API_KEY=AIza...
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODELO=gemini-3-flash-preview

# ---------- Opción C: otro servicio compatible con la API de OpenAI (Ollama, LM Studio, OpenAI...) ----------
# LLM_PROVEEDOR=openai_compatible
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODELO=<nombre del modelo descargado>

# ---------- Común ----------
# Segundos máximos de espera por llamada
LLM_TIEMPO_MAXIMO=60
# Pon 1 para usar siempre el método básico aunque haya clave
LLM_DESACTIVAR=0
